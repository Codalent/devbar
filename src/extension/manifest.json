{
  "manifest_version": 3,
  "name": "devbar",
  "version": "0.0.0",
  "description": "Log a bug, task or idea on any page, with a screenshot, a screen recording and console errors, and download it as Markdown for any AI.",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "devbar: log feedback on this page",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Open devbar on this page"
    }
  }
}
