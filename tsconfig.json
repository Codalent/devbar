{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // <DevBar /> imports the widget by its package name; point that at the source here.
    "paths": { "@codalent/devbar/client": ["./src/client/index.ts"] }
  },
  "include": ["src"]
}
